# Configuracao do servidor. Edite e salve: o servidor se atualiza sozinho em ate 2 minutos.

# Versao do Minecraft. O seu jogo e o dos seus amigos precisam usar esta mesma versao, com Fabric.
VERSAO_MINECRAFT=1.21.1

# Memoria para o servidor. A maquina gratis da Oracle tem 12 GB; 8G deixa folga para o sistema.
MEMORIA=8G

# Nome do modpack que os jogadores importam.
NOME_MODPACK="Servidor dos Amigos"

# Voce precisa aceitar a EULA do Minecraft para rodar um servidor: https://aka.ms/MinecraftEULA
ACEITAR_EULA=true
